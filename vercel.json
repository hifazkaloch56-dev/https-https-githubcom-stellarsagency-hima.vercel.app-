{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["**/*"]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/robots\\.txt",
      "dest": "server.js"
    },
    {
      "src": "/sitemap\\.xml",
      "dest": "server.js"
    },
    {
      "src": "/blog/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/blog\\.html",
      "dest": "/blog.html"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
